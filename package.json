{
  "name": "@ai-ecoverse/slicc-kernel",
  "version": "0.0.0",
  "description": "SLICC's wasm-realm kernel: run Emscripten programs in the browser against OPFS, with fork, spawn, pipes and waitpid",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-kernel.git"
  },
  "engines": {
    "node": ">=26"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-kernel",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/types/node.d.ts",
      "default": "./dist/node.js"
    },
    "./driver": {
      "types": "./dist/types/driver.d.ts",
      "default": "./dist/driver.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./meta": {
      "types": "./dist/types/meta.d.ts",
      "default": "./dist/meta.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "node build.mjs && slicc-install-hooks",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release",
    "start": "npm run build && node test/integration/chrome.mjs",
    "pretest": "npm run build && slicc-cdp install-browser",
    "test": "node --test --test-timeout=180000 --test-global-setup=node_modules/@ai-ecoverse/slicc-shared-web/harness/global.mjs 'test/integration/*.test.mjs'",
    "test:unit": "tools/heavy.sh env NODE_NO_WARNINGS=1 mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --import fake-indexeddb/auto --test --test-concurrency=2 --test-timeout=180000 'test/unit/**/*.test.mjs'",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "lint": "slicc-lint",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@ai-ecoverse/py-numpy": "2.5.4-4",
    "@ai-ecoverse/slicc-cdp": "1.30.23",
    "@ai-ecoverse/slicc-node": "2.5.2",
    "@ai-ecoverse/slicc-scrub": "1.0.0",
    "@ai-ecoverse/slicc-shared-web": "2.7.9",
    "@ai-ecoverse/wasi-cargo": "0.99.0-6",
    "@ai-ecoverse/wasi-pnpm": "12.9.1-21",
    "@ai-ecoverse/wasi-ripgrep": "15.2.0-5",
    "@ai-ecoverse/wasi-rustc": "1.98.1-10",
    "@ai-ecoverse/wasi-zig": "0.16.0-20",
    "@ai-ecoverse/wasix-python": "3.15.0-5",
    "@ai-ecoverse/wasm-bash": "5.3.0-23",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-13",
    "@ai-ecoverse/wasm-curl": "8.22.0-9",
    "@ai-ecoverse/wasm-git": "2.55.0-18",
    "@ai-ecoverse/wasm-gmake": "4.4.1-9",
    "@ai-ecoverse/wasm-procps": "4.0.7-5",
    "@ai-ecoverse/wasm-sqlite3": "3.54.0-7",
    "@ai-ecoverse/wasm-tar": "1.35.0-9",
    "@ai-ecoverse/wasm-tls-engine": "4.2.0-7",
    "@ai-ecoverse/wasm-tree": "2.3.2-7",
    "@ai-ecoverse/wasm-util-linux": "2.42.4-6",
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "lefthook": "2.2.2",
    "monocart-coverage-reports": "2.13.2",
    "pg-gateway": "0.3.0-beta.4",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "wabt": "1.0.39"
  }
}
