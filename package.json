{
  "name": "@ai-ecoverse/slicc-kernel",
  "version": "0.0.0",
  "description": "SLICC's wasm-realm kernel: run Emscripten programs in the browser against OPFS, with fork, spawn, pipes and waitpid",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-kernel.git"
  },
  "engines": {
    "node": ">=24"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "repo": "ai-ecoverse/slicc-kernel",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "node build.mjs && { [ ! -e .git ] || lefthook install; }",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release",
    "start": "npm run build && node test/integration/server.mjs",
    "pretest": "npm run build && playwright-core install --no-shell chromium",
    "test": "node --test --test-global-setup=test/integration/global.mjs 'test/integration/*.test.mjs'",
    "test:unit": "NODE_NO_WARNINGS=1 mcr -c mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "typecheck": "tsc",
    "lint": "biome check . && npm run typecheck && slicc-lint-comments && slicc-no-unit-tests",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "github:ai-ecoverse/slicc-shared-web#d28ddcb962913aff6771735165fe030e3aeb6f16",
    "@ai-ecoverse/wasm-bash": "5.3.0-7",
    "@ai-ecoverse/wasm-coreutils": "9.7.0-3",
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "lefthook": "2.1.16",
    "monocart-coverage-reports": "2.13.0",
    "playwright-core": "1.63.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  }
}
