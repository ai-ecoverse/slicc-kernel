(module
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "clock_time_get" (func $clock (param i32 i64 i32) (result i32)))
  (import "wasix_32v1" "futex_wait" (func $futex_wait (param i32 i32 i32 i32) (result i32)))
  (import "slicc" "sigmask_set" (func $sigmask_set (param i32 i32 i32 i32) (result i32)))
  (import "slicc" "sigwait" (func $sigwait (param i32 i32 i64 i32) (result i32)))
  (memory (export "memory") 1 1 shared)
  (data (i32.const 256) "futex ")
  (data (i32.const 272) "sigwait ")
  (data (i32.const 288) " ")
  (data (i32.const 290) "\n")
  (global $cursor (mut i32) (i32.const 512))
  (func $put (param $ptr i32) (param $len i32)
    (memory.copy (global.get $cursor) (local.get $ptr) (local.get $len))
    (global.set $cursor (i32.add (global.get $cursor) (local.get $len))))
  (func $flush
    (i32.store (i32.const 0) (i32.const 512))
    (i32.store (i32.const 4) (i32.sub (global.get $cursor) (i32.const 512)))
    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 16)))
    (global.set $cursor (i32.const 512)))
  (func $number (param $v i64)
    (local $at i32)
    (local.set $at (i32.const 200))
    (loop $digits
      (local.set $at (i32.sub (local.get $at) (i32.const 1)))
      (i32.store8 (local.get $at)
        (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $v) (i64.const 10)))))
      (local.set $v (i64.div_u (local.get $v) (i64.const 10)))
      (br_if $digits (i64.ne (local.get $v) (i64.const 0))))
    (call $put (local.get $at) (i32.sub (i32.const 200) (local.get $at))))
  (func $now (result i64)
    (drop (call $clock (i32.const 1) (i64.const 1) (i32.const 72)))
    (i64.div_u (i64.load (i32.const 72)) (i64.const 1000000)))
  (func $line (param $label i32) (param $len i32) (param $ms i64) (param $errno i32) (param $extra i32)
    (call $put (local.get $label) (local.get $len))
    (call $number (local.get $ms))
    (call $put (i32.const 288) (i32.const 1))
    (call $number (i64.extend_i32_u (local.get $errno)))
    (call $put (i32.const 288) (i32.const 1))
    (call $number (i64.extend_i32_u (local.get $extra)))
    (call $put (i32.const 290) (i32.const 1))
    (call $flush))
  (func (export "_start")
    (local $round i32)
    (local $start i64)
    (local $errno i32)
    (drop (call $sigmask_set (i32.const 0) (i32.const 512) (i32.const 0) (i32.const 0)))
    (loop $rounds
      (i32.store (i32.const 32) (i32.const 0))
      (i32.store8 (i32.const 48) (i32.const 1))
      (i64.store (i32.const 56) (i64.const 250000000))
      (i32.store8 (i32.const 64) (i32.const 9))
      (local.set $start (call $now))
      (local.set $errno (call $futex_wait (i32.const 32) (i32.const 0) (i32.const 48) (i32.const 64)))
      (call $line (i32.const 256) (i32.const 6) (i64.sub (call $now) (local.get $start))
        (local.get $errno) (i32.load8_u (i32.const 64)))
      (local.set $start (call $now))
      (local.set $errno (call $sigwait (i32.const 512) (i32.const 0) (i64.const 250000000) (i32.const 80)))
      (call $line (i32.const 272) (i32.const 8) (i64.sub (call $now) (local.get $start))
        (local.get $errno) (i32.load (i32.const 80)))
      (local.set $round (i32.add (local.get $round) (i32.const 1)))
      (br_if $rounds (i32.lt_u (local.get $round) (i32.const 4))))))
