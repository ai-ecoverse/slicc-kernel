{
  "name": "jstest",
  "private": true,
  "slicc": {
    "commands": {
      "jstest": {
        "abi": "js",
        "module": "bin/jstest.mjs",
        "env": {
          "JSTEST_PACKAGE": "${package}"
        }
      },
      "jsbad": {
        "abi": "js",
        "module": "bin/nomain.mjs"
      },
      "jsbroken": {
        "abi": "js",
        "module": "bin/broken.mjs"
      },
      "jsnomodule": {
        "abi": "js"
      },
      "jsecho": {
        "abi": "js",
        "module": "bin/echo.mjs"
      },
      "jsscript": {
        "script": "bin/jsscript"
      },
      "jsloop": {
        "script": "bin/jsloop"
      }
    },
    "binfmt": {
      ".jse": "jsecho",
      ".x.jse": "jstest",
      ".jss": "jsscript",
      ".jsl": "jsloop"
    }
  }
}
